<?xml version="1.0" encoding="utf-8"?>
<!-- 런처 아이콘 앞면 레이어: 방패 안에 체크를 "파낸"(evenOdd) 형태.
     체크를 흰색으로 덧그리지 않고 뚫어서, 뒤 배경 그라데이션이 그대로 비쳐 보이게 했다.
     모든 그림은 어댑티브 아이콘 안전 영역(가운데 66dp) 안에 들어가도록 잡았다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 방패 아래로 살짝 떨어지는 그림자 -->
    <path
        android:fillColor="#33000000"
        android:pathData="M54,29 L78,37.5 L78,57 C78,70.5 68,80 54,86.5 C40,80 30,70.5 30,57 L30,37.5 Z" />

    <!-- 방패 본체 + 체크 구멍 -->
    <path android:fillType="evenOdd"
        android:pathData="M54,26 L78,34.5 L78,54 C78,67.5 68,77 54,83.5 C40,77 30,67.5 30,54 L30,34.5 Z M41.5,54.5 L46,50 L50.5,54.5 L64,41 L68.5,45.5 L50.5,63.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="84">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFD9D3FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
